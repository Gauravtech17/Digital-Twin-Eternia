# Environment Configuration for POLYPULSE
# Copy this file to .env and adjust as necessary

# App Environment
ENVIRONMENT=development
PROJECT_NAME="POLYPULSE — The Living Lesion Digital Twin"
API_V1_STR="/api/v1"

# Database: SQLite for local dev, PostgreSQL for production
DATABASE_URL=sqlite:///./polypulse.db

# Security & Demo Auth (Demo only - not production clinical security)
SECRET_KEY=polypulse-demo-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Storage & Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=10485760

# Default Alert Thresholds (Demonstration values, not clinical)
TOLERANCE_GROWTH_MM=1.0
LOW_CONFIDENCE_THRESHOLD=0.60
LOW_QUALITY_THRESHOLD=0.50
